{
  "sourceLanguage": "en",
  "strings": {
    "android.error.adb-device-missing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Emulator is still running, but ADB did not discover the expected device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Emulator 仍在运行，但 ADB 未发现目标设备。"
          }
        }
      }
    },
    "android.error.adb-device-offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ADB discovered the dedicated Android Emulator, but the device remained offline."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ADB 已发现专用 Android Emulator，但设备一直处于 offline 状态。"
          }
        }
      }
    },
    "android.error.adb-private-server-failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OKVideoMac could not start its private ADB server. The system ADB server was not connected to or stopped."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OKVideoMac 无法启动独立的 ADB 服务；没有连接或关闭系统默认 ADB。"
          }
        }
      }
    },
    "android.error.adb-reconnect-failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bounded reconnect attempt for the dedicated Android Emulator failed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "专用 Android Emulator 的有界 ADB 重连失败。"
          }
        }
      }
    },
    "android.error.adb-unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ADB is unavailable, so OKVideoMac cannot connect to its dedicated Android Emulator."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ADB 无法使用，无法连接专用 Android Emulator。"
          }
        }
      }
    },
    "android.error.app-requested-termination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Emulator startup was cancelled or ended by OKVideoMac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Emulator 启动已由 App 取消或结束。"
          }
        }
      }
    },
    "android.error.avd-recovery-required": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The dedicated Android Runtime failed with both hardware and software rendering. Rebuild the Runtime from Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "专用 Android Runtime 使用硬件和软件渲染均无法启动；请在设置中重建 Runtime。"
          }
        }
      }
    },
    "android.error.boot-timeout": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android did not finish booting within the allowed time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 系统启动超时，兼容环境没有在预期时间内完成启动。"
          }
        }
      }
    },
    "android.error.bridge-health-timeout": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Bridge did not connect within the allowed time. This startup attempt has failed; try again or use Repair."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Bridge 未在限定时间内建立连接；本次启动已失败，请重试或使用“修复”。"
          }
        }
      }
    },
    "android.error.bridge-identity-mismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The detected Android Bridge does not belong to this startup session. The connection was refused."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到的 Android Bridge 不属于当前启动实例；已拒绝连接，请重新启动兼容环境。"
          }
        }
      }
    },
    "android.error.bridge-install-failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Bridge could not be installed. Reinstall OKVideoMac or export diagnostics."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Bridge 安装失败，请重新安装 OKVideoMac 或导出诊断。"
          }
        }
      }
    },
    "android.error.bridge-launch-failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Bridge did not start. Use Repair in Settings and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Bridge 服务启动失败，请使用“修复”后重试。"
          }
        }
      }
    },
    "android.error.bridge-version-mismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Bridge does not match this version of OKVideoMac. Use Repair to install the current Bridge."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Bridge 与当前 App 版本不一致；请使用“修复”重新安装当前 Bridge。"
          }
        }
      }
    },
    "android.error.emulator-launch-failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Emulator did not start correctly. Export diagnostics and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Emulator 未能正常启动，请导出诊断后重试。"
          }
        }
      }
    },
    "android.error.emulator-ownership-mismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OKVideoMac could not safely verify ownership of the dedicated Android Emulator and did not touch other devices."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法安全确认专用 Android Emulator，已停止操作其他设备。"
          }
        }
      }
    },
    "android.error.emulator-process-mismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recorded Android Emulator process no longer belongs to this startup session."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Emulator PID 已不再属于本次启动实例。"
          }
        }
      }
    },
    "android.error.emulator-runtime-conflict": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another Emulator is using the dedicated AVD or reserved ports. No process was terminated."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到其他 Emulator 正在使用专用 AVD 或记录端口，未执行任何操作。"
          }
        }
      }
    },
    "android.error.host-port-conflict": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local Android Bridge port is already in use. Close the conflicting app and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机 Android Bridge 端口被占用，请关闭冲突程序后重试。"
          }
        }
      }
    },
    "android.error.java-runtime-missing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creating or repairing an AVD with the selected external SDK requires a working Java runtime. Existing compatible AVDs can still be launched without it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用所选外部 SDK 创建或修复 AVD 需要可用的 Java Runtime；已有兼容 AVD 仍可正常启动。"
          }
        }
      }
    },
    "android.error.network-unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Emulator did not establish a usable network connection. Check your network and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Emulator 没有建立可用网络，请检查网络后重试。"
          }
        }
      }
    },
    "android.error.port-conflict": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A port required by Android Emulator is in use by another process. The other process was not terminated."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Emulator 所需端口被其他进程占用，未终止占用进程。"
          }
        }
      }
    },
    "android.error.port-forward-failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ADB port forwarding failed, so Android Bridge could not connect to the Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ADB 端口映射失败，Android Bridge 无法连接到 Mac。"
          }
        }
      }
    },
    "android.error.sdk-incomplete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected Android SDK is incomplete. Choose an SDK that includes ADB, Emulator, and a compatible system image in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android SDK 不完整，请在设置中选择包含 ADB、Emulator 和兼容系统镜像的 SDK。"
          }
        }
      }
    },
    "android.error.startup.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Compatibility Environment Failed to Start"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 兼容环境启动失败"
          }
        }
      }
    },
    "android.error.unexpected-serial": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ADB discovered another Emulator, but not the device expected for this startup session."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ADB 发现了其他 Emulator，但没有发现本次启动所预期的设备。"
          }
        }
      }
    },
    "android.error.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Android compatibility environment failed to start. Export diagnostics now for troubleshooting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 兼容环境启动失败，请立即导出诊断信息。"
          }
        }
      }
    },
    "android.install.error.cancelled.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can continue the next time Android content needs this component."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下次使用需要 Android 的内容时可以继续。"
          }
        }
      }
    },
    "android.install.error.cancelled.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installation Cancelled"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消安装"
          }
        }
      }
    },
    "android.install.error.catalog.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The installation catalog failed security validation. No runtime files were downloaded or changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装清单未通过安全校验，应用没有下载或修改任何运行环境。"
          }
        }
      }
    },
    "android.install.error.catalog.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Compatibility Component Is Temporarily Unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 兼容组件暂不可用"
          }
        }
      }
    },
    "android.install.error.compatibility.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac does not meet the system requirements for the current Android compatibility component."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 不满足当前 Android 兼容组件的系统要求。"
          }
        }
      }
    },
    "android.install.error.compatibility.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Compatibility Component Is Unsupported"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 兼容组件不受支持"
          }
        }
      }
    },
    "android.install.error.disk-space.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free up disk space, then continue the installation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "释放磁盘空间后可以继续安装。"
          }
        }
      }
    },
    "android.install.error.disk-space.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not Enough Disk Space"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用磁盘空间不足"
          }
        }
      }
    },
    "android.install.error.download.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Compatibility Component Download Failed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 兼容组件下载失败"
          }
        }
      }
    },
    "android.install.error.integrity.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The downloaded file failed its integrity check and was not installed. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载文件未通过完整性校验，未安装该文件。请重试。"
          }
        }
      }
    },
    "android.install.error.integrity.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Compatibility Component Verification Failed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 兼容组件校验失败"
          }
        }
      }
    },
    "android.install.error.internal.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The installation was not activated. The previous runtime remains unchanged. Try again or export diagnostics."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装未生效，原有运行环境保持不变。请重试或导出诊断。"
          }
        }
      }
    },
    "android.install.error.internal.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Compatibility Component Installation Failed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 兼容组件安装失败"
          }
        }
      }
    },
    "android.install.error.invalid-installation.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new environment was not activated. The previous runtime remains unchanged. Try again or export diagnostics."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新环境未生效，原有运行环境保持不变。请重试或导出诊断。"
          }
        }
      }
    },
    "android.install.error.invalid-installation.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android Compatibility Component Installation Failed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 兼容组件安装失败"
          }
        }
      }
    },
    "android.install.error.network.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The download did not finish. Any resumable data was preserved. Check your network and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载未完成，已保留可继传的部分文件。请检查网络后重试。"
          }
        }
      }
    },
    "cloud.status.authenticated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signed In"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已登录"
          }
        }
      }
    },
    "cloud.status.pending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previously Authorized"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次已授权"
          }
        }
      }
    },
    "cloud.status.title-format": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ - %2$@"
          }
        }
      }
    },
    "cloud.status.unauthenticated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not Signed In"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未登录"
          }
        }
      }
    },
    "common.cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "common.ok": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好"
          }
        }
      }
    },
    "common.restart": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart Now"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在重启"
          }
        }
      }
    },
    "language.en": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "English"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "English"
          }
        }
      }
    },
    "language.follow-system": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow System"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随系统"
